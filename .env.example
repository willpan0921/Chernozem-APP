# WHAT THIS FILE IS
# The list of private settings the Atlas server reads. Copy this file to a
# new file named ".env" (in the same folder) and fill in the values.
# .env is never uploaded to GitHub. Changes are picked up on the next
# request; restart "npm run dev" if something does not update.

# ---------- AI (Claude) ----------
# From console.anthropic.com -> API keys. Turns on the AI pages.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use.
CLAUDE_MODEL=claude-opus-5-5

# ---------- Google Earth Engine (real satellite data) ----------
# The Google Cloud project registered for Earth Engine.
GEE_PROJECT_ID=
# The service-account key: EITHER paste the whole key JSON on one line here...
GEE_SERVICE_ACCOUNT_JSON=
# ...OR give the path to the key file (for example ./service-account.json).
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: a private black-soil (chernozem) map asset. "none" uses the public
# OpenLandMap USDA soil-class map (Mollisols, 250 m), which works worldwide.
GEE_CHERNOZEM_ASSET=none
# Optional: an ACLED export (CSV of battles and explosions) for the distance
# to fighting. Without it, recent fire detections are used instead.
ACLED_CSV_PATH=
# Set to 1 to use sample data even when Earth Engine is set up.
GEE_DISABLED=

# ---------- Server ----------
# Port for "npm start" (the dev server always uses 5173).
PORT=8787
# Optional: where saved areas, runs, chats and the team are kept
# (default server/.data). "npm run dev" and "npm start" can share it; a
# lock file stops both from running the monthly analysis at once.
CHERNOZEM_DATA_DIR=

# ---------- Access code (optional) ----------
# Leave blank for use on this computer only: the app stays open and
# "npm start" only answers this computer.
# Set a code before handing the app to officials: everyone must type it
# once (it is remembered for 30 days in that browser), and "npm start"
# then answers the whole network. Changing the code signs everyone out.
# Use a long code (for example four random words you make up; never one
# printed in a document). Online (on Render) it must be at least 16
# characters, or the server does not start.
ATLAS_ACCESS_CODE=
# Optional: the address "npm start" listens on. Default 127.0.0.1 (this
# computer only) without an access code, 0.0.0.0 (the network) with one.
HOST=
# Set to 1 only when the app runs behind a proxy or tunnel (nginx, Caddy,
# Cloudflare Tunnel...), so the limit of 10 wrong codes per 10 minutes
# counts each visitor separately instead of everyone as the proxy.
# "cloudflare" is for Render, where every request comes through Cloudflare
# (render.yaml sets it for https://chernozem.app; on Render it is also
# what 1 or a blank means).
ATLAS_TRUST_PROXY=

# ---------- One-time data upload (only on the online server) ----------
# While set, POST /api/admin/import accepts the data sent by
# scripts/export-data.js with this token (docs/DEPLOY.md, section 5).
# Use a long random text (at least 16 characters), and remove it once the
# upload is done.
IMPORT_TOKEN=
