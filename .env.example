# WHAT THIS FILE IS
# The list of private settings the Atlas server reads. Copy this file to a
# new file named ".env" (in the same folder) and fill in the values.
# .env is never uploaded to GitHub. Changes are picked up on the next
# request; restart "npm run dev" if something does not update.

# ---------- AI (Claude) ----------
# From console.anthropic.com -> API keys. Turns on the AI pages.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use.
CLAUDE_MODEL=claude-opus-5-5

# ---------- Google Earth Engine (real satellite data) ----------
# The Google Cloud project registered for Earth Engine.
GEE_PROJECT_ID=
# The service-account key: EITHER paste the whole key JSON on one line here...
GEE_SERVICE_ACCOUNT_JSON=
# ...OR give the path to the key file (for example ./service-account.json).
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: a private black-soil (chernozem) map asset. "none" uses the public
# OpenLandMap USDA soil-class map (Mollisols, 250 m), which works worldwide.
GEE_CHERNOZEM_ASSET=none
# Optional: an ACLED export (CSV of battles and explosions) for the distance
# to fighting. Without it, recent fire detections are used instead.
ACLED_CSV_PATH=
# Set to 1 to use sample data even when Earth Engine is set up.
GEE_DISABLED=

# ---------- Server ----------
# Port for "npm start" (the dev server always uses 5173).
PORT=8787
# Optional: where saved areas, runs, chats and the team are kept
# (default server/.data). "npm run dev" and "npm start" can share it; a
# lock file stops both from running the monthly analysis at once.
CHERNOZEM_DATA_DIR=

# ---------- The owner's key (once "the access code"; optional here) ----------
# Leave blank for use on this computer only: everyone who reaches the app
# may change everything, and "npm start" only answers this computer.
# Set a key before others can reach the app: visitors then see the
# read-only public demo (no key, no sign-in), and the owner types the key
# once on the hidden page /owner (remembered for 30 days in that browser)
# to change the demo and read the contact messages. "npm start" then
# answers the whole network. Changing the key signs the owner out
# everywhere. Use a long key (for example four random words you make up;
# never one printed in a document). Online (on Render) it must be at least
# 16 characters, or the server does not start.
ATLAS_ACCESS_CODE=
# Optional: the address "npm start" listens on. Default 127.0.0.1 (this
# computer only) without the owner's key, 0.0.0.0 (the network) with one.
HOST=
# Set to 1 only when the app runs behind a proxy or tunnel (nginx, Caddy,
# Cloudflare Tunnel...), so the limits per visitor (10 wrong keys per 10
# minutes, 5 contact messages an hour, the demo assistant's questions)
# count each visitor separately instead of everyone as the proxy.
# "cloudflare" is for Render, where every request comes through Cloudflare
# (render.yaml sets it for https://chernozem.app; on Render it is also
# what 1 or a blank means).
ATLAS_TRUST_PROXY=

# ---------- Registered accounts (the website's Register page) ----------
# People who register (Google, or e-mail and password, through Firebase
# Authentication) each get a workspace of their own, kept under
# <data folder>/users/. The public demo is untouched.
# The server checks their sign-ins with Firebase's library (firebase-admin)
# for this project. Optional: left blank, the Earth Engine project above is
# used (it is the same Google Cloud project), else "chernozem-danny".
# "off" switches registration off (the page says so).
FIREBASE_PROJECT_ID=
# Only on this computer, for trying the sign-in without touching Google:
# the local Firebase Auth emulator, for example 127.0.0.1:9099
# (docs/DEPLOY.md, "Accounts"). Never set this online.
FIREBASE_AUTH_EMULATOR_HOST=

# ---------- Contact e-mail (the website's contact form) ----------
# Every message is kept on the server and e-mailed to MAIL_TO (blank:
# chernozem.app@gmail.com); one not sent yet is tried again every 10
# minutes. The first way set wins; none set: the messages wait on the
# server (Atlas > Settings) until one is (docs/DEPLOY.md, "Contact e-mail").
MAIL_TO=
# 1. Gmail: an app password of the Gmail account that sends (made at
#    https://myaccount.google.com/apppasswords, needs 2-Step Verification;
#    16 letters, spaces allowed). GMAIL_USER: that account (blank: MAIL_TO).
GMAIL_APP_PASSWORD=
GMAIL_USER=
# 2. Any other mail server (SMTP). SMTP_SECURE: 1 for TLS from the start
#    (blank: only on port 465; 587 upgrades by itself).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
# 3. Resend (resend.com): an API key starting with re_.
RESEND_API_KEY=
# Optional: who the e-mail says it is from (blank: "Chernozem website
# <the Gmail or SMTP account>", or "Chernozem website
# <onboarding@resend.dev>" for Resend).
MAIL_FROM=

# ---------- One-time data upload (only on the online server) ----------
# While set, POST /api/admin/import accepts the data sent by
# scripts/export-data.js with this token (docs/DEPLOY.md, section 5).
# Use a long random text (at least 16 characters), and remove it once the
# upload is done.
IMPORT_TOKEN=
