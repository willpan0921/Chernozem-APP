# Files Git should NOT save or upload to GitHub.

# Downloaded libraries. Anyone can recreate this folder with "npm install".
node_modules

# The built version of the app, created by "npm run build".
dist

# Private settings and computer-specific clutter.
.env
.env.local

# Service account keys. Keep keys outside the project folder (see
# scripts/fetch-ndvi.js); these lines are a second guard in case one is
# copied in by mistake.
*-key.json
service-account*.json
chernozem-danny-*.json
.DS_Store
*.log

# The Atlas server's saved areas, runs, chats and team (local data).
server/.data

# Private keys: never commit an Earth Engine service-account key.
*.key.json
service-account*.json

# The design skill the owner installed with "npx skills add" (skills-lock.json says where it comes from)
.agents/
# The design inspector's screenshots and reports; the dealt direction sheet is kept
.taste-skill/*
!.taste-skill/direction.json
# The owner's mockup PDFs and reference pictures, kept next to the code but not in git
Other Files/
